<%- include('../../partials/head') %>
<%- include('../../partials/sidebar') %>
<div class="admin-main">
  <%- include('../../partials/topbar') %>
  <main class="admin-content" id="np-main-content">
    <%- include('../../partials/flash') %>
    <div class="np-page-header">
      <div>
        <h1>WAF Logs</h1>
        <p class="np-help-text mb-0">Search, filter, and investigate blocked or suspicious requests.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="np-btn np-btn-secondary" href="/admin/waf/logs/export/csv<%= Object.keys(filters || {}).length ? '?' + new URLSearchParams(filters).toString() : '' %>">Export CSV</a>
        <a class="np-btn np-btn-secondary" href="/admin/waf">Dashboard</a>
      </div>
    </div>

    <%- include('../../partials/waf-nav', { activeNav: 'logs' }) %>

    <form class="np-widget mb-3" method="get" action="/admin/waf/logs">
      <div class="np-widget-header"><span>Filter logs</span><span class="np-badge np-badge-muted"><%= meta.total %> total</span></div>
      <div class="np-widget-body">
        <div class="row g-2">
          <div class="col-md-3"><input class="form-control font-monospace" name="ip" value="<%= filters.ip || '' %>" placeholder="IP address"></div>
          <div class="col-md-3"><input class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Search URL, rule, user-agent"></div>
          <div class="col-md-2">
            <select class="form-select" name="category">
              <option value="">All categories</option>
              <% categories.forEach(function(cat) { %><option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= wafUi.categoryLabel(cat) %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="severity">
              <option value="">All severities</option>
              <% severities.forEach(function(sev) { %><option value="<%= sev %>" <%= filters.severity === sev ? 'selected' : '' %>><%= sev %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="action">
              <option value="">All actions</option>
              <% actions.forEach(function(action) { %><option value="<%= action %>" <%= filters.action === action ? 'selected' : '' %>><%= action %></option><% }) %>
            </select>
          </div>
          <div class="col-md-2"><input class="form-control" type="date" name="date" value="<%= filters.date || '' %>"></div>
          <div class="col-md-2"><input class="form-control" name="country" value="<%= filters.country || '' %>" placeholder="Country code"></div>
          <div class="col-md-2"><button class="np-btn np-btn-primary w-100" type="submit">Apply</button></div>
          <div class="col-md-2"><a class="np-btn np-btn-secondary w-100" href="/admin/waf/logs">Reset</a></div>
        </div>
      </div>
    </form>

    <div class="np-widget">
      <div class="np-widget-body p-0">
        <div class="table-responsive">
          <table class="np-list-table mb-0">
            <thead>
              <tr>
                <th>Time</th>
                <th>IP</th>
                <th>Method</th>
                <th>URL</th>
                <th>Category</th>
                <th>Severity</th>
                <th>Action</th>
                <th>Risk</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% logs.forEach(function(row) { %>
                <tr>
                  <td class="text-nowrap"><%= formatDateTime(row.created_at) %></td>
                  <td><a href="<%= wafUi.buildLogFilterUrl({ ip: row.ip_address }) %>"><code><%= row.ip_address %></code></a></td>
                  <td><span class="np-badge np-badge-muted"><%= row.method %></span></td>
                  <td class="small text-break" style="max-width:240px"><%= row.url %></td>
                  <td><a href="<%= wafUi.buildLogFilterUrl({ category: row.category }) %>"><span class="np-badge np-badge-muted"><%= wafUi.categoryLabel(row.category) %></span></a></td>
                  <td><span class="np-badge np-badge-<%= wafUi.severityBadge(row.severity) %>"><%= row.severity || '-' %></span></td>
                  <td><span class="np-badge np-badge-<%= wafUi.actionBadge(row.action_taken) %>"><%= row.action_taken %></span></td>
                  <td><span class="np-badge np-badge-<%= wafUi.riskLevel(row.risk_score).class %>"><%= row.risk_score %></span></td>
                  <td class="text-end text-nowrap">
                    <a class="np-btn np-btn-small np-btn-secondary" href="/admin/waf/logs/<%= row.id %>">Details</a>
                    <form method="post" action="/admin/waf/logs/<%= row.id %>/block-ip" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="return_to" value="/admin/waf/logs">
                      <button class="np-btn np-btn-small np-btn-danger" type="submit">Block IP</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (!logs.length) { %>
                <tr><td colspan="9" class="text-center text-muted py-5">No WAF logs match your filters.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <% if (meta.pages > 1) { %>
        <% const qs = new URLSearchParams(filters || {}); %>
        <div class="np-widget-footer px-3 py-2 border-top d-flex justify-content-between align-items-center">
          <span class="text-muted small">Page <%= meta.page %> of <%= meta.pages %> · <%= meta.total %> entries</span>
          <div class="d-flex gap-2">
            <% if (meta.page > 1) { qs.set('page', meta.page - 1); %><a class="np-btn np-btn-small np-btn-secondary" href="/admin/waf/logs?<%= qs.toString() %>">Previous</a><% } %>
            <% if (meta.page < meta.pages) { qs.set('page', meta.page + 1); %><a class="np-btn np-btn-small np-btn-secondary" href="/admin/waf/logs?<%= qs.toString() %>">Next</a><% } %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="np-widget mt-3">
      <div class="np-widget-header"><span>Log maintenance</span></div>
      <div class="np-widget-body">
        <form method="post" action="/admin/waf/logs/delete-old" class="row g-2 align-items-end" onsubmit="return confirm('Delete logs older than the selected age?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-3">
            <label class="form-label">Delete logs older than (days)</label>
            <input class="form-control" type="number" min="1" name="days" value="<%= settings.waf_log_retention_days || 90 %>">
          </div>
          <div class="col-md-3"><button class="np-btn np-btn-danger" type="submit">Purge old logs</button></div>
        </form>
      </div>
    </div>
  </main>
</div>
<%- include('../../partials/footer') %>
