<%- include('../../partials/head') %>
<%- include('../../partials/sidebar') %>
<div class="admin-main">
  <%- include('../../partials/topbar') %>
  <main class="admin-content" id="np-main-content">
    <%- include('../../partials/flash') %>
    <div class="np-page-header">
      <div>
        <h1>WAF Log #<%= log.id %></h1>
        <p class="np-help-text mb-0">Full request context, matched rules, and response action.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="np-btn np-btn-secondary" href="/admin/waf/logs">Back to logs</a>
        <form method="post" action="/admin/waf/logs/<%= log.id %>/whitelist-ip" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="return_to" value="/admin/waf/logs/<%= log.id %>">
          <button class="np-btn np-btn-secondary" type="submit">Whitelist IP</button>
        </form>
        <form method="post" action="/admin/waf/logs/<%= log.id %>/block-ip" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="return_to" value="/admin/waf/logs/<%= log.id %>">
          <button class="np-btn np-btn-danger" type="submit">Block IP</button>
        </form>
      </div>
    </div>

    <%- include('../../partials/waf-nav', { activeNav: 'logs' }) %>

    <div class="np-stat-grid mb-3">
      <div class="np-stat-card"><span class="stat-label">Risk score</span><h3><span class="np-badge np-badge-<%= wafUi.riskLevel(log.risk_score).class %>"><%= log.risk_score %></span></h3></div>
      <div class="np-stat-card"><span class="stat-label">Action</span><h3><span class="np-badge np-badge-<%= wafUi.actionBadge(log.action_taken) %>"><%= log.action_taken %></span></h3></div>
      <div class="np-stat-card"><span class="stat-label">Severity</span><h3><span class="np-badge np-badge-<%= wafUi.severityBadge(log.severity) %>"><%= log.severity || '-' %></span></h3></div>
      <div class="np-stat-card"><span class="stat-label">Category</span><h3><%= wafUi.categoryLabel(log.category) %></h3></div>
    </div>

    <div class="row g-3">
      <div class="col-lg-6">
        <div class="np-widget">
          <div class="np-widget-header"><span>Request summary</span></div>
          <div class="np-widget-body">
            <dl class="row mb-0 np-waf-detail-list">
              <dt class="col-sm-4">Time</dt><dd class="col-sm-8"><%= formatDateTime(log.created_at) %></dd>
              <dt class="col-sm-4">Request ID</dt><dd class="col-sm-8"><code><%= log.request_id %></code></dd>
              <dt class="col-sm-4">IP address</dt><dd class="col-sm-8"><code><%= log.ip_address %></code></dd>
              <dt class="col-sm-4">Country</dt><dd class="col-sm-8"><%= log.country || '—' %></dd>
              <dt class="col-sm-4">Method</dt><dd class="col-sm-8"><%= log.method %></dd>
              <dt class="col-sm-4">Route type</dt><dd class="col-sm-8"><%= log.route_type || '—' %></dd>
              <dt class="col-sm-4">URL</dt><dd class="col-sm-8 text-break"><code><%= log.url %></code></dd>
              <dt class="col-sm-4">Matched rule</dt><dd class="col-sm-8"><%= log.matched_rule_name || '—' %><% if (log.WafRule) { %> <a href="/admin/waf/rules/<%= log.WafRule.id %>/edit">Edit rule</a><% } %></dd>
              <dt class="col-sm-4">User agent</dt><dd class="col-sm-8 text-break small"><%= log.user_agent || '—' %></dd>
              <dt class="col-sm-4">Referer</dt><dd class="col-sm-8 text-break small"><%= log.referer || '—' %></dd>
              <dt class="col-sm-4">Admin route</dt><dd class="col-sm-8"><%= log.is_admin_route ? 'Yes' : 'No' %></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="np-widget mb-3">
          <div class="np-widget-header"><span>Query string</span></div>
          <div class="np-widget-body"><pre class="np-code-block mb-0"><%= wafUi.formatSnapshot(log.query_snapshot) || '{}' %></pre></div>
        </div>
        <div class="np-widget mb-3">
          <div class="np-widget-header"><span>Request body</span></div>
          <div class="np-widget-body"><pre class="np-code-block mb-0"><%= wafUi.formatSnapshot(log.body_snapshot) || '{}' %></pre></div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="np-widget">
          <div class="np-widget-header"><span>Headers</span></div>
          <div class="np-widget-body"><pre class="np-code-block mb-0"><%= wafUi.formatSnapshot(log.headers_snapshot) || '{}' %></pre></div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="np-widget">
          <div class="np-widget-header"><span>Uploaded files</span></div>
          <div class="np-widget-body"><pre class="np-code-block mb-0"><%= wafUi.formatSnapshot(log.file_snapshot) || '[]' %></pre></div>
        </div>
      </div>
    </div>

    <form method="post" action="/admin/waf/logs/<%= log.id %>/delete" class="mt-3" onsubmit="return confirm('Delete this log entry permanently?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="np-btn np-btn-danger" type="submit">Delete log entry</button>
    </form>
  </main>
</div>
<%- include('../../partials/footer') %>
